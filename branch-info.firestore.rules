// Rules for the ccb_branch_info collection. Paste into Firestore > Rules for the project, then Publish.
// Replace the provider ID and editor emails (lowercase) before publishing.
// Everyone who signs in through the Okta provider can READ; only editorEmails() can add or change sites.
// Nobody can delete from the web page.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function oktaProviderId() { return 'oidc.REPLACE-WITH-PROVIDER-ID'; }
    function editorEmails() { return ['REPLACE-WITH-EDITOR-EMAIL@example.com']; }

    function isViewer() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == oktaProviderId();
    }
    function isEditor() {
      return isViewer()
        && 'email' in request.auth.token
        && request.auth.token.email.lower() in editorEmails();
    }
    function validSite() {
      let d = request.resource.data;
      return d.keys().hasOnly(['address', 'address2', 'city', 'contacts', 'costCenter', 'description',
                               'primary', 'region', 'secondary', 'siteName', 'state', 'status',
                               'thirdOctet', 'users', 'zip', 'updatedBy', 'updatedAt'])
        && d.siteName is string && d.siteName.size() > 0 && d.siteName.size() <= 200;
    }

    match /ccb_branch_info/{siteId} {
      allow read: if isViewer();
      allow create, update: if isEditor() && validSite();
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
